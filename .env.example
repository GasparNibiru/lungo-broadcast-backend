# Servidor
PORT=3333
NODE_ENV=production

# Administração e banco de dados (staging)
ADMIN_ACCESS_KEY=SUBSTITUA_POR_UMA_CHAVE_FORTE
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=SUA_SECRET_KEY_DO_SUPABASE

# Domínios que podem chamar a API.
# Use * apenas para teste. Em produção, coloque seu domínio do Netlify.
# Ex.: https://disparos.lungo.com.br,https://seu-site.netlify.app
ALLOWED_ORIGINS=*

# Evolution API
# Ex.: https://evolution.seudominio.com.br
EVOLUTION_BASE_URL=https://SUA-EVOLUTION-API-AQUI.com.br
EVOLUTION_API_KEY=SUA_API_KEY_GLOBAL_AQUI

# Endpoints padrão atuais da Evolution API.
# Só altere se sua instalação usar um caminho diferente.
EVOLUTION_CONNECTION_PATH=/instance/connectionState/:instanceName
EVOLUTION_SEND_TEXT_PATH=/message/sendText/:instanceName

# Checagem de conexão antes de iniciar campanha.
# true = pula checagem; false = exige instância conectada/open.
SKIP_CONNECTION_CHECK=false

# Upload
MAX_UPLOAD_MB=10

# Intervalos padrão entre mensagens.
# Pode ser sobrescrito por cliente em data/instances.json
DEFAULT_MIN_DELAY_MS=8000
DEFAULT_MAX_DELAY_MS=25000

# Limite padrão de contatos por campanha.
# Pode ser sobrescrito por cliente em data/instances.json
DEFAULT_MAX_CONTACTS_PER_CAMPAIGN=5000

# Delay interno enviado no corpo do sendText da Evolution, em milissegundos.
# Geralmente pode ficar 0 porque o controle principal já é feito pela fila do backend.
EVOLUTION_MESSAGE_DELAY_MS=0

# Servidor
PORT=3333
NODE_ENV=production
APP_ENV=production

# Diretorio persistente exclusivo deste ambiente.
# No EasyPanel de staging, use um volume exclusivo montado em /data-staging.
DATA_DIR=/data

# Administração e banco de dados (staging)
ADMIN_ACCESS_KEY=SUBSTITUA_POR_UMA_CHAVE_FORTE
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=SUA_SECRET_KEY_DO_SUPABASE

# Banco separado de Inteligencia Empresarial. Use a chave secreta somente no backend.
BUSINESS_INTELLIGENCE_SUPABASE_URL=https://fmktrtyahaudefcymrvm.supabase.co
BUSINESS_INTELLIGENCE_SUPABASE_KEY=SUA_SECRET_KEY_DO_SUPABASE_EMPRESARIAL

# Protecao fail-closed do staging. O backend nao inicia se SUPABASE_URL apontar
# para producao ou se qualquer arquivo persistente estiver fora de DATA_DIR.
STAGING_SUPABASE_PROJECT_REF=hgqtanlzajogxrfbchrl
PRODUCTION_SUPABASE_PROJECT_REF=bnceclhjhgjfirubudwi

# Caminhos opcionais. Em staging, quando omitidos, sao derivados de DATA_DIR.
CLIENTS_FILE_PATH=/data/clientes.json
LEADS_FILE_PATH=/data/leads.json
CUSTOMER_CLIENTS_FILE_PATH=/data/customer_clients.json
ACCESS_TOKENS_FILE_PATH=/data/access-tokens.json
INSTANCES_FILE_PATH=/data/instances.json

# Domínios que podem chamar a API.
# Use * apenas para teste. Em produção, coloque seu domínio do Netlify.
# Ex.: https://disparos.lungo.com.br,https://seu-site.netlify.app
ALLOWED_ORIGINS=*

# Meta Lead Ads. Nunca coloque esses segredos no frontend.
# META_GRAPH_API_VERSION deve ser a versao configurada no seu aplicativo Meta (ex.: vXX.X).
META_GRAPH_API_VERSION=vXX.X
META_PAGE_ACCESS_TOKEN=SEU_TOKEN_DE_ACESSO_DA_PAGINA
META_APP_SECRET=SEU_APP_SECRET
META_WEBHOOK_VERIFY_TOKEN=CRIE_UMA_FRASE_SECRETA_FORTE

# Evolution API
# Ex.: https://evolution.seudominio.com.br
EVOLUTION_BASE_URL=https://SUA-EVOLUTION-API-AQUI.com.br
EVOLUTION_API_KEY=SUA_API_KEY_GLOBAL_AQUI

# Endpoints padrão atuais da Evolution API.
# Só altere se sua instalação usar um caminho diferente.
EVOLUTION_CONNECTION_PATH=/instance/connectionState/:instanceName
EVOLUTION_SEND_TEXT_PATH=/message/sendText/:instanceName

# Checagem de conexão antes de iniciar campanha.
# true = pula checagem; false = exige instância conectada/open.
SKIP_CONNECTION_CHECK=false

# Upload
MAX_UPLOAD_MB=10

# Intervalos padrão entre mensagens.
# Pode ser sobrescrito por cliente em data/instances.json
DEFAULT_MIN_DELAY_MS=8000
DEFAULT_MAX_DELAY_MS=25000

# Limite padrão de contatos por campanha.
# Pode ser sobrescrito por cliente em data/instances.json
DEFAULT_MAX_CONTACTS_PER_CAMPAIGN=5000

# Delay interno enviado no corpo do sendText da Evolution, em milissegundos.
# Geralmente pode ficar 0 porque o controle principal já é feito pela fila do backend.
EVOLUTION_MESSAGE_DELAY_MS=0
